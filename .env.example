# Core application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: required when moving from local demo storage to shared production data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: server-side only. Never prefix the key with NEXT_PUBLIC_.
AI_PROVIDER=maxplus
AI_MODEL=claude-opus-5
MAXPLUSAI_API_KEY=
MAXPLUSAI_BASE_URL=https://api.maxplus-ai.cc
MAXPLUSAI_POOL=claude-native
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Billing gateway: intentionally empty until subscription validation
BILLING_PROVIDER=manual
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
