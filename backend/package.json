{
  "name": "@tuydui/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-database.ts",
    "db:migration": "node --env-file-if-exists=.env.local scripts/run-migration.mjs",
    "db:collaboration": "node --env-file-if-exists=.env.local scripts/run-collab-migration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
